// ============================================================
// firestore.rules
// Firestore Security Rules for Oshi Smart Expenses.
//
// HOW TO APPLY:
//   1. Go to Firebase Console → Firestore Database → Rules tab
//   2. Replace the existing rules with the content below
//   3. Click "Publish"
//
// These rules ensure:
//   - Only authenticated users can read/write data
//   - Each user can ONLY access their own data (not others')
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user has their own document tree under /users/{uid}/
    // Only the authenticated user matching {uid} can access it
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
